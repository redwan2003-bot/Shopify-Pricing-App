{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shopify-pricing-app",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./build/client",
  },

  "previews": {
    "vars": {
      "SHOPIFY_API_KEY": "preview_api_key",
      "SHOPIFY_API_SECRET": "preview_shared_secret_value",
      "SCOPES": "write_products,write_cart_transforms,write_validations,write_publications,read_orders",
      "SHOPIFY_APP_URL": "https://example.com",
    },
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
