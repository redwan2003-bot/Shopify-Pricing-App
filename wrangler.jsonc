{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shopify-pricing-app",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./build/client",
  },

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
