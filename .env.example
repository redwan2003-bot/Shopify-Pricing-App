# Dedicated secret for signing/verifying cart pricing payloads — NOT the Shopify OAuth
# secret (SHOPIFY_API_SECRET, managed by the Shopify CLI, is never used for this). Must
# match the value baked into the Cart Transform Function at build time (see
# extensions/imprintid-cart-pricing/scripts/generate-config.mjs). Leave blank locally;
# cart pricing simply stays unavailable (fails closed) until this is set to a real
# value with no leading or trailing whitespace.
IMPRINTID_CART_SIGNING_SECRET=

# Required format: gid://shopify/ProductVariant/<positive-numeric-id>
IMPRINTID_ADJUSTMENT_VARIANT_ID=
