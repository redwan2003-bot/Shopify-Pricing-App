# Dedicated secret for signing/verifying cart pricing payloads — NOT the Shopify OAuth
# secret (SHOPIFY_API_SECRET, managed by the Shopify CLI, is never used for this). Must
# match the value baked into both Functions at build time. `npm run fn:config` reads
# this line of the real (git-ignored) .env when the env var is unset, so the value never
# needs to appear on a command line — `scripts/shopify/provision.mjs --prepare` writes
# it here for you. Leave blank locally; cart pricing simply stays unavailable (fails
# closed) until it is a real value with no leading or trailing whitespace.
IMPRINTID_CART_SIGNING_SECRET=

# Required format: gid://shopify/ProductVariant/<positive-numeric-id>. Written by
# `scripts/shopify/provision.mjs --prepare`.
IMPRINTID_ADJUSTMENT_VARIANT_ID=

# --- Cart-pricing envelope selection (Task 5B.1.1) -----------------------------------
# Which signed-quote envelope the server may ISSUE. There is NO silent default: if this
# is unset or unsupported, no signed cart-pricing payload is produced (cartPricing:null).
#   "2" — envelope v2 (the intended production version; bound to app-owned metafield
#         revisions). Fails closed until an authoritative policy provider exists.
#   "1" — legacy v1. Issued ONLY for controlled NON-PRODUCTION transition work, and only
#         when IMPRINTID_ALLOW_LEGACY_CART_PRICING_V1 is exactly "true". Production never
#         issues a v1 quote regardless of this value.
IMPRINTID_CART_ENVELOPE_VERSION=

# Set to exactly "true" ONLY in a non-production environment to permit issuing legacy
# envelope-v1 quotes (paired with IMPRINTID_CART_ENVELOPE_VERSION="1"). Any other value,
# or production runtime (NODE_ENV=production), disables v1 issuance.
IMPRINTID_ALLOW_LEGACY_CART_PRICING_V1=
