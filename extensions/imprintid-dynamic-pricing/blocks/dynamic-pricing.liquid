  window.ImprintIdPricingStrings = {
    "dynamic_pricing.unsupported_product": {{ 'dynamic_pricing.unsupported_product' | t | json }},
    "dynamic_pricing.invalid_quantity": {{ 'dynamic_pricing.invalid_quantity' | t | json }},
    "dynamic_pricing.configuration_error": {{ 'dynamic_pricing.configuration_error' | t | json }},
    "dynamic_pricing.network_error": {{ 'dynamic_pricing.network_error' | t | json }},
    "dynamic_pricing.option_none": {{ 'dynamic_pricing.option_none' | t | json }},
    "dynamic_pricing.related_sku_hint": {{ 'dynamic_pricing.related_sku_hint' | t | json }},
    "dynamic_pricing.tier_note": {{ 'dynamic_pricing.tier_note' | t | json }},
    "dynamic_pricing.breakdown_base": {{ 'dynamic_pricing.breakdown_base' | t | json }},
    "dynamic_pricing.breakdown_color": {{ 'dynamic_pricing.breakdown_color' | t | json }},
    "dynamic_pricing.breakdown_decoration": {{ 'dynamic_pricing.breakdown_decoration' | t | json }},
    "dynamic_pricing.breakdown_options": {{ 'dynamic_pricing.breakdown_options' | t | json }},
    "dynamic_pricing.breakdown_production": {{ 'dynamic_pricing.breakdown_production' | t | json }},
    "dynamic_pricing.breakdown_total_list": {{ 'dynamic_pricing.breakdown_total_list' | t | json }},
    "dynamic_pricing.breakdown_total": {{ 'dynamic_pricing.breakdown_total' | t | json }},
    "dynamic_pricing.add_to_cart": {{ 'dynamic_pricing.add_to_cart' | t | json }},
    "dynamic_pricing.adding_to_cart": {{ 'dynamic_pricing.adding_to_cart' | t | json }},
    "dynamic_pricing.added_to_cart": {{ 'dynamic_pricing.added_to_cart' | t | json }},
    "dynamic_pricing.add_to_cart_error": {{ 'dynamic_pricing.add_to_cart_error' | t | json }},
    "dynamic_pricing.add_to_cart_unavailable": {{ 'dynamic_pricing.add_to_cart_unavailable' | t | json }},
    "dynamic_pricing.option_included": {{ 'dynamic_pricing.option_included' | t | json }},
    "dynamic_pricing.option_price_unavailable": {{ 'dynamic_pricing.option_price_unavailable' | t | json }},
    "dynamic_pricing.variant_changed": {{ 'dynamic_pricing.variant_changed' | t | json }},
    "dynamic_pricing.variant_unavailable": {{ 'dynamic_pricing.variant_unavailable' | t | json }},
    "dynamic_pricing.variant_sync_error": {{ 'dynamic_pricing.variant_sync_error' | t | json }}
  };
</script>
{%- comment -%} Module scripts are deferred by default; dynamic-pricing.js imports
   dynamic-pricing-utils.js directly (see that file), so only one tag is needed here. {%- endcomment -%}
<script type="module" src="{{ 'dynamic-pricing.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Dynamic Pricing",
  "target": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    },
    {
      "type": "text",
      "id": "sku_override",
      "label": "Override SKU",
      "info": "Leave blank to use the current product's SKU automatically."
    },
    {
      "type": "checkbox",
      "id": "show_breakdown_by_default",
      "label": "Expand price breakdown by default",
      "default": false
    }
  ]
}
{% endschema %}
