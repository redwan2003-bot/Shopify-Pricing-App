# Production Environment Variables for ImprintID Dynamic Pricing

# Hosting URL (must match the URL configured in Shopify Partner Dashboard —
# currently https://shopify-pricing-app.pdbd-primeit.workers.dev; see shopify.app.production.toml)
SHOPIFY_APP_URL=https://shopify-pricing-app.pdbd-primeit.workers.dev

# Shopify App Credentials (from Shopify Partner Dashboard > Apps > ImprintID Dynamic Pricing > Client credentials)
SHOPIFY_API_KEY=replace_with_the_app_client_id
SHOPIFY_API_SECRET=replace_with_the_app_client_secret
SCOPES=write_products,write_cart_transforms,write_validations,write_publications,read_orders

# Neon PostgreSQL. DATABASE_URL is the pooled connection; DATABASE_URL_UNPOOLED is used by
# Prisma Migrate. In production these are Cloudflare Worker secrets, not a file.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Cart Signing Secret (matches baked Function secret). Generate your own — never reuse a
# value that has appeared in this file's git history or anywhere else outside your secret
# manager. `npm run fn:config` bakes the real value from your git-ignored .env into both
# Functions at build time; it never needs to appear on a command line or in git.
IMPRINTID_CART_SIGNING_SECRET=replace_with_a_freshly_generated_random_secret

# OPTIONAL. Leave unset for a public (multi-store) app: each store's adjustment variant is
# created on install and read from that store's own enforcement policy. Set it only to pin a
# single-store deployment to one variant (quotes then fail if the store's policy differs).
IMPRINTID_ADJUSTMENT_VARIANT_ID=gid://shopify/ProductVariant/your_variant_id_here

# Cart Pricing Envelope Version (v2 for production)
IMPRINTID_CART_ENVELOPE_VERSION=2

# Private artwork/proof storage (Cloudflare R2 via its S3-compatible API).
# Keep the bucket private; the app issues short-lived presigned URLs only.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=imprintid-private
R2_ACCESS_KEY_ID=replace_with_an_r2_bucket_scoped_access_key
R2_SECRET_ACCESS_KEY=replace_with_the_r2_secret_access_key
R2_REGION=auto
