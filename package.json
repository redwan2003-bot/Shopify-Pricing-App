{
  "name": "imprint-id-dynamic-pricing",
  "private": true,
  "scripts": {
    "build": "npm run storefront:build && prisma generate && react-router build",
    "predev": "npm run fn:config",
    "dev": "shopify app dev",
    "predeploy": "npm run storefront:build && npm run fn:config",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "db:seed": "prisma db seed",
    "db:seed:test": "node --env-file=.env.test prisma/seed.ts",
    "fn:config": "node extensions/imprintid-cart-pricing/scripts/generate-config.mjs && node extensions/imprintid-cart-validation/scripts/generate-config.mjs",
    "storefront:build": "node scripts/build-storefront-assets.mjs",
    "pretest": "npm run storefront:build && npm run fn:config && prisma generate",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"app/**/*.test.ts\" \"extensions/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:editor-live": "node --env-file=.env.test --experimental-loader=./scripts/resolve-ts-loader.mjs scripts/_editor-live.mjs",
    "catalog:import": "node scripts/import-catalog-pricing.ts",
    "catalog:link": "node scripts/shopify/link-catalog-pricing.mjs",
    "preview:storefront": "node --env-file=.env --experimental-loader=./scripts/resolve-ts-loader.mjs scripts/preview/server.mjs",
    "verify:app-proxy": "node --experimental-loader=./scripts/resolve-ts-loader.mjs scripts/verify-app-proxy.mjs",
    "provision": "node scripts/shopify/provision.mjs",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "pretypecheck": "npm run fn:config && prisma generate",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "type": "module",
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.16.3",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@graphql-codegen/cli": "5.0.7",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "jsdom": "^30.0.1",
    "liquidjs": "^10.29.0",
    "prettier": "^3.6.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "wrangler": "^4.153.0"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "pnpm": {
    "overrides": {
      "p-map": "^4.0.0",
      "lodash@<=4.17.23": "4.18.1",
      "deepmerge-ts@<8.0.0": "8.0.2",
      "@graphql-tools/utils@<=12.0.1": "12.0.2",
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "undici@>=7.0.0 <7.30.1": "7.30.1"
    }
  },
  "author": "reahs"
}
