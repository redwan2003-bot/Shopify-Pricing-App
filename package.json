{
  "name": "imprint-id-dynamic-pricing",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "predev": "npm run fn:config",
    "dev": "shopify app dev",
    "predeploy": "npm run fn:config",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "db:seed": "prisma db seed",
    "fn:config": "node extensions/imprintid-cart-pricing/scripts/generate-config.mjs && node extensions/imprintid-cart-validation/scripts/generate-config.mjs",
    "pretest": "npm run fn:config",
    "test": "node --test --test-concurrency=1 \"app/**/*.test.ts\" \"extensions/**/*.test.ts\" \"test/**/*.test.ts\"",
    "preview:storefront": "node --env-file=.env --experimental-loader=./scripts/resolve-ts-loader.mjs scripts/preview/server.mjs",
    "verify:app-proxy": "node --experimental-loader=./scripts/resolve-ts-loader.mjs scripts/verify-app-proxy.mjs",
    "provision": "node scripts/shopify/provision.mjs",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "pretypecheck": "npm run fn:config",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "jsdom": "^30.0.1",
    "liquidjs": "^10.29.0",
    "prettier": "^3.6.2",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "reahs"
}
